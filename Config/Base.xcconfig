// Base.xcconfig
// onsarj — tüm yapılandırmaların paylaştığı derleme ayarları.
//
// KURAL: Derleme ayarı Xcode arayüzünden DEĞİL, bu dosyalardan değiştirilir.
// Arayüzden yapılan değişiklik project.pbxproj içine gömülür, denetlenemez
// ve ekip arkadaşlarıyla çakışır.

// ─── Platform ───────────────────────────────────────────────
// K-05: Minimum iOS 17, yalnızca iPhone.
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator

// ─── Swift ──────────────────────────────────────────────────
// Swift 6 dil modu; strict concurrency bu modda zaten zorunludur,
// ayrıca SWIFT_STRICT_CONCURRENCY yazmaya gerek yoktur.
SWIFT_VERSION = 6.0

// ─── Sürüm ──────────────────────────────────────────────────
// Uygulama ve widget eklentisi aynı sürüm numarasını taşır.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ─── Kod kalitesi ───────────────────────────────────────────
GCC_WARN_UNDECLARED_SELECTOR = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES

// NOT: Bundle identifier bilerek burada tanımlanmadı.
// Uygulama, widget eklentisi ve test hedefleri farklı kimlikler taşır;
// bu yüzden hedef düzeyinde kalır. Widget hedefini eklediğimizde
// hedefe özel xcconfig dosyaları oluşturulacaktır.
