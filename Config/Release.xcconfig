// Release.xcconfig
// TestFlight ve App Store dağıtımı için kullanılan yapılandırma.
// Öncelik: çalışma hızı ve küçük uygulama boyutu.

#include "Base.xcconfig"

// Tam eniyileştirme. Derleme yavaşlar, uygulama hızlanır.
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule

// Tüm mimariler derlenir (dağıtım için zorunlu).
ONLY_ACTIVE_ARCH = NO

ENABLE_TESTABILITY = NO
VALIDATE_PRODUCT = YES
