// Debug.xcconfig
// Geliştirme sırasında kullanılan yapılandırma.
// Öncelik: hızlı derleme ve iyi hata ayıklama.

#include "Base.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1

// Eniyileştirme kapalı — derleme hızlı, hata ayıklama doğru.
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_COMPILATION_MODE = incremental

// Yalnızca o anki mimari derlenir; simülatör derlemesini hızlandırır.
ONLY_ACTIVE_ARCH = YES

// @testable import için gerekli.
ENABLE_TESTABILITY = YES
